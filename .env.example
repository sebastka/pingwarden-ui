# --- Pingwarden ---
# The UI talks to Pingwarden's API from the server side; browsers never reach Pingwarden, so
# it needs no CORS and its API can stay on an internal network.
PINGWARDEN_URL=http://localhost:8081      # npm run dev:pingwarden; in production e.g. http://pingwarden:8080
# PINGWARDEN_TIMEOUT_SECONDS=10

# --- Access: AUTH_MODE=oidc or AUTH_MODE=token (required) ---
#
# token: no sign-in. The UI reads Pingwarden with PINGWARDEN_TOKEN (a `read` token from
# Pingwarden's server.api_tokens; unset with Pingwarden's anonymous_read). Anyone who can reach
# the dashboard sees it, so the dashboard is read-only unless READ_ONLY=false (and then the
# token's scope decides). Meant for wall displays and trusted networks.
AUTH_MODE=token
PINGWARDEN_TOKEN=dev-read-token-0123456789
#
# oidc: users sign in with your identity provider (authorization code + PKCE). The UI sends
# each user's access token to Pingwarden, which checks it against its server.auth.oidc
# (issuer, audience, read/admin roles): Pingwarden decides who may read and who may act.
# Register a client with redirect URI ${PUBLIC_URL}/auth/callback and, for RP-initiated
# logout, post-logout redirect URI ${PUBLIC_URL}/auth/logged-out. Its access tokens must carry
# Pingwarden's audience (Keycloak: an audience mapper; Authentik: same provider).
#
# The development stack (npm run dev:pingwarden) with its mock provider, which accepts any user
# name; put {"roles": ["pingwarden-admin"]} or {"roles": ["pingwarden-read"]} in the claims box:
# AUTH_MODE=oidc
# PUBLIC_URL=http://localhost:5173        # the Vite dev server; in production https://status.example.com
# OIDC_ISSUER=http://localhost:8090/default
# OIDC_ALLOW_INSECURE_ISSUER=true         # http:// issuer, for the local mock only
# OIDC_CLIENT_ID=pingwarden-ui
# OIDC_CLIENT_SECRET=dev-secret           # unset for a public client (then OIDC_TOKEN_AUTH_METHOD=none)
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic  # or client_secret_post, client_secret_jwt, none
# OIDC_SCOPES=openid profile email
# OIDC_AUTH_PARAMS=audience=pingwarden    # extra authorization parameters (Auth0: audience; RFC 8707: resource)
# Optional hint, mirroring Pingwarden's server.auth.oidc claim and admin values: with it, users
# without the admin role see actions greyed out from the start (otherwise after a first refusal).
# OIDC_ROLES_CLAIM=roles                  # e.g. realm_access.roles (Keycloak), groups (Authentik)
# OIDC_ADMIN_ROLES=pingwarden-admin
# SESSION_TTL_HOURS=12                    # sign in again after this long; sessions live in memory

# --- Actions ---
# Runtime actions: check now, pause/resume, test a notifier, reload the configuration.
# READ_ONLY=true                          # default: true with AUTH_MODE=token, false with oidc

# --- HTTP ---
# LISTEN_HOST=127.0.0.1                   # 0.0.0.0 in the container image
# PORT=3000
# PUBLIC_URL=https://status.example.com   # required with OIDC; its host is also accepted by the Host check
# ALLOWED_HOSTS=wall.lan                  # other Host names to accept (DNS rebinding guard); * = any
# REFRESH_SECONDS=15                      # how often the UI reloads live data

# --- Development and tests ---
# The compose stack (npm run dev:pingwarden): Pingwarden on 127.0.0.1:8081 (DEV_PINGWARDEN_PORT),
# the mock OIDC provider on 127.0.0.1:8090 (MOCK_OIDC_PORT).
# End-to-end tests against it (npm test); unset to skip them:
# TEST_PINGWARDEN_URL=http://localhost:8081
# TEST_OIDC_ISSUER=http://localhost:8090/default
